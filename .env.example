NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge
REDIS_HOST=localhost
REDIS_PORT=6379

# Origen permitido por CORS para el frontend. Opcional: por defecto es http://localhost:3001.
CORS_ORIGIN=http://localhost:3001

# SMTP para la action 'notification' (Fase 2). Opcional: sin configurar, la app arranca igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URL publica del frontend (Fase 4): a donde redirige el callback de OAuth de GitHub al terminar.
FRONTEND_URL=http://localhost:3001

# Action 'ai_task' (Fase 4). AI_PROVIDER: 'gemini' (default) u 'ollama'. Opcional: sin configurar,
# la app arranca igual y el paso 'ai_task' falla en runtime con un mensaje claro.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Si el backend corre en Docker y Ollama en el host, usar http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Action 'github' + OAuth (Fase 4). Crear una OAuth App en https://github.com/settings/developers
# con "Authorization callback URL" = GITHUB_OAUTH_REDIRECT_URI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/github/callback
# Clave de 32 bytes en hex (64 caracteres) para encriptar el access_token de GitHub en reposo.
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
